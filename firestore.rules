rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Customer reviews: anyone can read and create a valid review.
    // Nobody can edit or delete from the website; remove unwanted reviews from the Firebase console.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'rating', 'service', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 800
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data['service'] is string && request.resource.data['service'].size() <= 60
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
